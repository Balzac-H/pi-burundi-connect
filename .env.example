# Arija — variables d'environnement
# Copiez ce fichier vers .env et complétez. Ne commitez JAMAIS un .env rempli.

# ----------------------------------------------------------------- Domaine
# URL canonique de l'app déployée, sans slash final (ex. : https://arija.example.com).
# Sert aux balises meta/og (canonical, og:url), au manifest (start_url, scope)
# et au sitemap/robots (URL absolues). Vide = URLs relatives.
VITE_APP_URL=

# ---------------------------------------------------------------- Supabase
# Côté navigateur (VITE_*) — publics
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Côté serveur (server functions / SSR)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret : clé de service (RLS contournée). Jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------- Pi
# Secret : clé API du Pi Developer Portal (complet, commençant par sk_...).
# Sert à appeler https://api.minepi.com/v2 (paiements, /me).
PI_API_KEY=
# true = réseau de test (sandbox / Testnet), false = Mainnet.
# Passer à false une fois l'app validée sur le Pi Developer Portal.
VITE_PI_SANDBOX=true
# Domaine des comptes techniques Pi : l'email de compte est pi-<uid>@<domaine>.
VITE_ACCOUNT_EMAIL_DOMAIN=pi.wico.app

# ------------------------------------------------------------------ Support
# Email de support affiché sur la page /support. Vide = aucun email affiché.
VITE_SUPPORT_EMAIL=

# --------------------------------------------------- Optionnel (assistant IA)
# LOVABLE_API_KEY=
